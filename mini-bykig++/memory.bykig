// memory.bykig - Scoped Environment, Heap Objects, and Function Registry for mini-bykig++

// Scope Stack
float scopeId = 0 ;
float scopeStackTop = 0 ;
map scopeStack = { "0" = 0 } ;

func pushScope ( ) {
    scopeId = scopeId + 1 ;
    scopeStackTop = scopeStackTop + 1 ;
    scopeStack [ scopeStackTop ] = scopeId ;
}

func popScope ( ) {
    if scopeStackTop > 0
    {
        scopeStackTop = scopeStackTop - 1 ;
    }
}

func currentScopeId ( ) {
    float sid = scopeStack [ scopeStackTop ] ;
    return sid ;
}

// Variables storage
// envType: 0 = Number, 1 = String, 2 = List (ObjId), 3 = Map (ObjId)
map envVal = { "null" = 0 } ;
map envType = { "null" = 0 } ;

func getVarScopeKey ( string name ) {
    float idx = scopeStackTop ;
    while idx >= 0
    {
        float sid = scopeStack [ idx ] ;
        string k = sid + "_" + name ;
        float ex = exists ( envVal , k ) ;
        if ex ~ 1
        {
            return k ;
        }
        idx = idx - 1 ;
    }
    return "" ;
}

func getVarScope ( string name ) {
    float idx = scopeStackTop ;
    while idx >= 0
    {
        float sid = scopeStack [ idx ] ;
        string k = sid + "_" + name ;
        float ex = exists ( envVal , k ) ;
        if ex ~ 1
        {
            return sid ;
        }
        idx = idx - 1 ;
    }
    return 0 - 1 ;
}

func hasVar ( string name ) {
    float sid = getVarScope ( name ) ;
    if sid >= 0
    {
        return 1 ;
    }
    return 0 ;
}

func defVarVal ( string name , string valStr , float valNum , float valType ) {
    float sid = currentScopeId ( ) ;
    string k = sid + "_" + name ;
    envType [ k ] = valType ;
    if valType ~ 1
    {
        envVal [ k ] = valStr ;
    }
    else
    {
        envVal [ k ] = valNum ;
    }
}

func setVarVal ( string name , string valStr , float valNum , float valType ) {
    string k = getVarScopeKey ( name ) ;
    if k ~ ""
    {
        float sid = currentScopeId ( ) ;
        k = sid + "_" + name ;
    }
    envType [ k ] = valType ;
    if valType ~ 1
    {
        envVal [ k ] = valStr ;
    }
    else
    {
        envVal [ k ] = valNum ;
    }
}

// Backward-compatible helpers
func defVar ( string name , string valStr , float valNum , float isStr ) {
    if isStr ~ 1
    {
        defVarVal ( name , valStr , 0 , 1 ) ;
    }
    else
    {
        defVarVal ( name , "" , valNum , 0 ) ;
    }
}

func setVar ( string name , string valStr , float valNum , float isStr ) {
    if isStr ~ 1
    {
        setVarVal ( name , valStr , 0 , 1 ) ;
    }
    else
    {
        setVarVal ( name , "" , valNum , 0 ) ;
    }
}

func getVarVal ( string name ) {
    string k = getVarScopeKey ( name ) ;
    return envVal [ k ] ;
}

func getVarType ( string name ) {
    string k = getVarScopeKey ( name ) ;
    float t = envType [ k ] ;
    return t ;
}

func getVarIsStr ( string name ) {
    float t = getVarType ( name ) ;
    if t ~ 1
    {
        return 1 ;
    }
    return 0 ;
}

// Heap Objects Storage (Dynamic Lists and Generic Maps)
float nextObjId = 1 ;

func allocObjId ( ) {
    float id = nextObjId ;
    nextObjId = nextObjId + 1 ;
    return id ;
}

// Lists storage
map listSize = { "null" = 0 } ;
map listData = { "null" = 0 } ;
map listElemType = { "null" = 0 } ;

func newList ( ) {
    float id = allocObjId ( ) ;
    listSize [ id ] = 0 ;
    return id ;
}

func listPush ( float listId , string valStr , float valNum , float valType ) {
    float sz = listSize [ listId ] ;
    string k = listId + "_" + sz ;
    listElemType [ k ] = valType ;
    if valType ~ 1
    {
        listData [ k ] = valStr ;
    }
    else
    {
        listData [ k ] = valNum ;
    }
    listSize [ listId ] = sz + 1 ;
}

func listGetVal ( float listId , float idx ) {
    string k = listId + "_" + idx ;
    return listData [ k ] ;
}

func listGetType ( float listId , float idx ) {
    string k = listId + "_" + idx ;
    float t = listElemType [ k ] ;
    return t ;
}

func listSet ( float listId , float idx , string valStr , float valNum , float valType ) {
    string k = listId + "_" + idx ;
    listElemType [ k ] = valType ;
    if valType ~ 1
    {
        listData [ k ] = valStr ;
    }
    else
    {
        listData [ k ] = valNum ;
    }
    float sz = listSize [ listId ] ;
    if idx >= sz
    {
        listSize [ listId ] = idx + 1 ;
    }
}

func listPop ( float listId ) {
    float sz = listSize [ listId ] ;
    if sz <= 0
    {
        return 0 ;
    }
    sz = sz - 1 ;
    listSize [ listId ] = sz ;
    string k = listId + "_" + sz ;
    return listData [ k ] ;
}

func listPopType ( float listId ) {
    float sz = listSize [ listId ] ;
    string k = listId + "_" + sz ;
    float t = listElemType [ k ] ;
    return t ;
}

func listLen ( float listId ) {
    float sz = listSize [ listId ] ;
    return sz ;
}

// Maps storage
map mapCount = { "null" = 0 } ;
map mapHasKey = { "null" = 0 } ;
map mapVals = { "null" = 0 } ;
map mapValTypes = { "null" = 0 } ;
map mapKeys = { "null" = "" } ;

func newMap ( ) {
    float id = allocObjId ( ) ;
    mapCount [ id ] = 0 ;
    return id ;
}

func mapSet ( float mapId , string key , string valStr , float valNum , float valType ) {
    string hk = mapId + "_" + key ;
    float ex = mapHasKey [ hk ] ;
    if ex ! 1
    {
        float cnt = mapCount [ mapId ] ;
        string idxK = mapId + "_" + cnt ;
        mapKeys [ idxK ] = key ;
        mapCount [ mapId ] = cnt + 1 ;
        mapHasKey [ hk ] = 1 ;
    }
    mapValTypes [ hk ] = valType ;
    if valType ~ 1
    {
        mapVals [ hk ] = valStr ;
    }
    else
    {
        mapVals [ hk ] = valNum ;
    }
}

func mapGetVal ( float mapId , string key ) {
    string hk = mapId + "_" + key ;
    return mapVals [ hk ] ;
}

func mapGetType ( float mapId , string key ) {
    string hk = mapId + "_" + key ;
    float t = mapValTypes [ hk ] ;
    return t ;
}

func mapExists ( float mapId , string key ) {
    string hk = mapId + "_" + key ;
    float ex = mapHasKey [ hk ] ;
    if ex ~ 1
    {
        return 1 ;
    }
    return 0 ;
}

func mapDelete ( float mapId , string key ) {
    string hk = mapId + "_" + key ;
    float ex = mapHasKey [ hk ] ;
    if ex ~ 1
    {
        mapHasKey [ hk ] = 0 ;
        float cnt = mapCount [ mapId ] ;
        if cnt > 0
        {
            mapCount [ mapId ] = cnt - 1 ;
        }
    }
}

func mapLen ( float mapId ) {
    float cnt = mapCount [ mapId ] ;
    return cnt ;
}

// Value Formatter for Output and String Conversion
func formatValue ( string valStr , float valNum , float valType ) {
    if valType ~ 0
    {
        return "" + valNum ;
    }
    if valType ~ 1
    {
        return valStr ;
    }
    if valType ~ 2
    {
        float listId = valNum ;
        float sz = listSize [ listId ] ;
        string s = "[" ;
        float i = 0 ;
        while i < sz
        {
            if i > 0
            {
                s = s + ", " ;
            }
            string k = listId + "_" + i ;
            float elemT = listElemType [ k ] ;
            if elemT ~ 1
            {
                string itemS = listData [ k ] ;
                s = s + itemS ;
            }
            else
            {
                float itemN = listData [ k ] ;
                string itemStr = formatValue ( "" , itemN , elemT ) ;
                s = s + itemStr ;
            }
            i = i + 1 ;
        }
        s = s + "]" ;
        return s ;
    }
    if valType ~ 3
    {
        float mapId = valNum ;
        float cnt = mapCount [ mapId ] ;
        string s = "{" ;
        float i = 0 ;
        float printed = 0 ;
        while i < cnt
        {
            string idxK = mapId + "_" + i ;
            string k = mapKeys [ idxK ] ;
            string hk = mapId + "_" + k ;
            float ex = mapHasKey [ hk ] ;
            if ex ~ 1
            {
                if printed > 0
                {
                    s = s + ", " ;
                }
                float elemT = mapValTypes [ hk ] ;
                if elemT ~ 1
                {
                    string itemS = mapVals [ hk ] ;
                    s = s + quote ( k ) + ": " + itemS ;
                }
                else
                {
                    float itemN = mapVals [ hk ] ;
                    string itemStr = formatValue ( "" , itemN , elemT ) ;
                    s = s + quote ( k ) + ": " + itemStr ;
                }
                printed = printed + 1 ;
            }
            i = i + 1 ;
        }
        s = s + "}" ;
        return s ;
    }
    if valType ~ 4
    {
        float objId = valNum ;
        if objId ~ 0
        {
            return "null" ;
        }
        string cname = objClass [ objId ] ;
        return "<Object " + cname + "#" + objId + ">" ;
    }
    return "" ;
}

// Function registry
map funcPos = { "null" = 0 } ;
map funcParamCount = { "null" = 0 } ;
map funcParams = { "null" = "" } ;

func registerFunc ( string name , float pos , float pCount , string p0 , string p1 , string p2 , string p3 ) {
    funcPos [ name ] = pos ;
    funcParamCount [ name ] = pCount ;
    if pCount > 0
    {
        string k0 = name + "_0" ;
        funcParams [ k0 ] = p0 ;
    }
    if pCount > 1
    {
        string k1 = name + "_1" ;
        funcParams [ k1 ] = p1 ;
    }
    if pCount > 2
    {
        string k2 = name + "_2" ;
        funcParams [ k2 ] = p2 ;
    }
    if pCount > 3
    {
        string k3 = name + "_3" ;
        funcParams [ k3 ] = p3 ;
    }
}

func hasFunc ( string name ) {
    float ex = exists ( funcPos , name ) ;
    return ex ;
}

func getFuncPos ( string name ) {
    float pos = funcPos [ name ] ;
    return pos ;
}

func getFuncParamCount ( string name ) {
    float count = funcParamCount [ name ] ;
    return count ;
}

func getFuncParamName ( string name , float idx ) {
    if idx ~ 0
    {
        string k0 = name + "_0" ;
        string p0 = funcParams [ k0 ] ;
        return p0 ;
    }
    if idx ~ 1
    {
        string k1 = name + "_1" ;
        string p1 = funcParams [ k1 ] ;
        return p1 ;
    }
    if idx ~ 2
    {
        string k2 = name + "_2" ;
        string p2 = funcParams [ k2 ] ;
        return p2 ;
    }
    if idx ~ 3
    {
        string k3 = name + "_3" ;
        string p3 = funcParams [ k3 ] ;
        return p3 ;
    }
    return "" ;
}

// Control flow & Return values
float hasReturn = 0 ;
float loopBreak = 0 ;
float loopContinue = 0 ;

string retValStr = "" ;
float retValNum = 0 ;
float retValType = 0 ;

func setReturnValue ( string valStr , float valNum , float valType ) {
    hasReturn = 1 ;
    retValStr = valStr ;
    retValNum = valNum ;
    retValType = valType ;
}

func getReturnVal ( ) {
    if retValType ~ 1
    {
        return retValStr ;
    }
    return retValNum ;
}

func getReturnType ( ) {
    return retValType ;
}

func getReturnIsStr ( ) {
    if retValType ~ 1
    {
        return 1 ;
    }
    return 0 ;
}

// ==========================================
// OOP: Class Registry and Object Storage
// ==========================================

map classExists = { "null" = 0 } ;
map classParent = { "null" = "" } ;
map classFieldCount = { "null" = 0 } ;
map classFields = { "null" = "" } ;
map classFieldPrivate = { "null" = 0 } ;
map classFieldOwner = { "null" = "" } ;

map classMethodCount = { "null" = 0 } ;
map classMethods = { "null" = "" } ;
map classMethodPos = { "null" = 0 } ;
map classMethodParamCount = { "null" = 0 } ;
map classMethodParams = { "null" = "" } ;
map classMethodPrivate = { "null" = 0 } ;
map classMethodOwner = { "null" = "" } ;

map classHasCtor = { "null" = 0 } ;
map classCtorPos = { "null" = 0 } ;
map classCtorParamCount = { "null" = 0 } ;
map classCtorParams = { "null" = "" } ;
map classCtorPrivate = { "null" = 0 } ;

func registerClass ( string name , string parentName ) {
    if parentName ! ""
    {
        if parentName ~ name
        {
            out "Error: Class '" + name + "' cannot extend itself%n" ;
            return 0 ;
        }
        float pEx = exists ( classExists , parentName ) ;
        if pEx ! 1
        {
            out "Error: Parent class '" + parentName + "' not found%n" ;
            return 0 ;
        }
    }
    classExists [ name ] = 1 ;
    classParent [ name ] = parentName ;
    classFieldCount [ name ] = 0 ;
    classMethodCount [ name ] = 0 ;
    classHasCtor [ name ] = 0 ;
    return 1 ;
}

func findFieldDeclClass ( string className , string fieldName ) {
    string curClass = className ;
    while curClass ! ""
    {
        string fk = curClass + "_" + fieldName ;
        float ex = exists ( classFieldOwner , fk ) ;
        if ex ~ 1
        {
            return curClass ;
        }
        curClass = classParent [ curClass ] ;
    }
    return "" ;
}

func canAccessField ( string className , string fieldName ) {
    string owner = findFieldDeclClass ( className , fieldName ) ;
    if owner ~ ""
    {
        return 1 ;
    }
    string fk = owner + "_" + fieldName ;
    float isPriv = classFieldPrivate [ fk ] ;
    if isPriv ! 1
    {
        return 1 ;
    }
    string callerContext = getThisExecClass ( ) ;
    if callerContext ~ owner
    {
        return 1 ;
    }
    return 0 ;
}

func registerClassField ( string className , string fieldName , float isPriv ) {
    float cnt = classFieldCount [ className ] ;
    if cnt >= 64
    {
        out "Error: Class '" + className + "' exceeds maximum field capacity%n" ;
        return 0 ;
    }
    string parentName = classParent [ className ] ;
    if parentName ! ""
    {
        string pOwner = findFieldDeclClass ( parentName , fieldName ) ;
        if pOwner ! ""
        {
            out "Error: Duplicate field '" + fieldName + "' in class '" + className + "'%n" ;
            return 0 ;
        }
    }
    string idxK = className + "_" + cnt ;
    classFields [ idxK ] = fieldName ;
    classFieldCount [ className ] = cnt + 1 ;
    
    string fk = className + "_" + fieldName ;
    classFieldPrivate [ fk ] = isPriv ;
    classFieldOwner [ fk ] = className ;
    return 1 ;
}

func registerClassMethod ( string className , string methodName , float pos , float pCount , string p0 , string p1 , string p2 , string p3 , float isPriv ) {
    float cnt = classMethodCount [ className ] ;
    if cnt >= 64
    {
        out "Error: Class '" + className + "' exceeds maximum method capacity%n" ;
        return 0 ;
    }
    string parentName = classParent [ className ] ;
    if parentName ! ""
    {
        string pClass = findMethodClass ( parentName , methodName ) ;
        if pClass ! ""
        {
            string pmk = pClass + "_" + methodName ;
            float parentPCount = classMethodParamCount [ pmk ] ;
            if pCount ! parentPCount
            {
                out "Error: Overridden method '" + methodName + "' parameter count mismatch in class '" + className + "'%n" ;
            }
            float parentPriv = classMethodPrivate [ pmk ] ;
            if parentPriv ~ 0 && isPriv ~ 1
            {
                out "Error: Cannot reduce visibility of inherited method '" + methodName + "' in class '" + className + "'%n" ;
            }
        }
    }
    string idxK = className + "_" + cnt ;
    classMethods [ idxK ] = methodName ;
    classMethodCount [ className ] = cnt + 1 ;
    
    string mk = className + "_" + methodName ;
    classMethodPos [ mk ] = pos ;
    classMethodParamCount [ mk ] = pCount ;
    classMethodPrivate [ mk ] = isPriv ;
    classMethodOwner [ mk ] = className ;
    if pCount > 0
    {
        classMethodParams [ mk + "_0" ] = p0 ;
    }
    if pCount > 1
    {
        classMethodParams [ mk + "_1" ] = p1 ;
    }
    if pCount > 2
    {
        classMethodParams [ mk + "_2" ] = p2 ;
    }
    if pCount > 3
    {
        classMethodParams [ mk + "_3" ] = p3 ;
    }
    return 1 ;
}

func registerClassConstructor ( string className , float pos , float pCount , string p0 , string p1 , string p2 , string p3 , float isPriv ) {
    classHasCtor [ className ] = 1 ;
    classCtorPos [ className ] = pos ;
    classCtorParamCount [ className ] = pCount ;
    classCtorPrivate [ className ] = isPriv ;
    string ck = className + "_ctor" ;
    if pCount > 0
    {
        classCtorParams [ ck + "_0" ] = p0 ;
    }
    if pCount > 1
    {
        classCtorParams [ ck + "_1" ] = p1 ;
    }
    if pCount > 2
    {
        classCtorParams [ ck + "_2" ] = p2 ;
    }
    if pCount > 3
    {
        classCtorParams [ ck + "_3" ] = p3 ;
    }
    return 1 ;
}

func findMethodClass ( string className , string methodName ) {
    string curClass = className ;
    while curClass ! ""
    {
        string mk = curClass + "_" + methodName ;
        float ex = exists ( classMethodPos , mk ) ;
        if ex ~ 1
        {
            return curClass ;
        }
        curClass = classParent [ curClass ] ;
    }
    return "" ;
}

func isSubclass ( string childClass , string parentClass ) {
    if childClass ~ parentClass
    {
        return 1 ;
    }
    string cur = classParent [ childClass ] ;
    while cur ! ""
    {
        if cur ~ parentClass
        {
            return 1 ;
        }
        cur = classParent [ cur ] ;
    }
    return 0 ;
}

// Object Storage (Type 4)
map objClass = { "null" = "" } ;
map objFieldVal = { "null" = 0 } ;
map objFieldValStr = { "null" = "" } ;
map objFieldType = { "null" = 0 } ;

func newObjectInstance ( string className ) {
    float id = allocObjId ( ) ;
    objClass [ id ] = className ;
    return id ;
}

func initObjectFields ( float objId , string className ) {
    string curClass = className ;
    while curClass ! ""
    {
        float fCount = classFieldCount [ curClass ] ;
        float i = 0 ;
        while i < fCount
        {
            string idxK = curClass + "_" + i ;
            string fName = classFields [ idxK ] ;
            string fk = objId + "_" + fName ;
            float ex = exists ( objFieldType , fk ) ;
            if ex ! 1
            {
                setObjectField ( objId , fName , "" , 0 , 0 ) ;
            }
            i = i + 1 ;
        }
        curClass = classParent [ curClass ] ;
    }
}

func setObjectField ( float objId , string fieldName , string valStr , float valNum , float valType ) {
    string fk = objId + "_" + fieldName ;
    objFieldType [ fk ] = valType ;
    if valType ~ 1
    {
        objFieldValStr [ fk ] = valStr ;
    }
    else
    {
        objFieldVal [ fk ] = valNum ;
    }
}

func getObjectFieldVal ( float objId , string fieldName ) {
    string fk = objId + "_" + fieldName ;
    float t = objFieldType [ fk ] ;
    if t ~ 1
    {
        return objFieldValStr [ fk ] ;
    }
    return objFieldVal [ fk ] ;
}

func getObjectFieldType ( float objId , string fieldName ) {
    string fk = objId + "_" + fieldName ;
    float t = objFieldType [ fk ] ;
    return t ;
}

// 'this' Receiver Stack
float thisStackTop = 0 - 1 ;
map thisStack = { "null" = 0 } ;
map thisClassStack = { "null" = "" } ;

func pushThis ( float objId , string execClass ) {
    thisStackTop = thisStackTop + 1 ;
    thisStack [ thisStackTop ] = objId ;
    thisClassStack [ thisStackTop ] = execClass ;
}

func popThis ( ) {
    if thisStackTop >= 0
    {
        thisStackTop = thisStackTop - 1 ;
    }
}

func getThisObj ( ) {
    if thisStackTop >= 0
    {
        float id = thisStack [ thisStackTop ] ;
        return id ;
    }
    return 0 ;
}

func getThisExecClass ( ) {
    if thisStackTop >= 0
    {
        string c = thisClassStack [ thisStackTop ] ;
        return c ;
    }
    return "" ;
}
.
