var score = 85 ;
if score >= 90
{
    out 90 ;
}
elif score >= 80
{
    out 80 ;
}
else
{
    out 0 ;
}

var counter = 0 ;
var sum = 0 ;
while counter < 10
{
    counter = counter + 1 ;
    if counter == 3
    {
        continue ;
    }
    if counter > 5
    {
        break ;
    }
    sum = sum + counter ;
}
out sum ;

var total = 0 ;
for var i = 1 ; i <= 5 ; i = i + 1
{
    total = total + i ;
}
out total ;

var x = 100 ;
if x == 100
{
    var x = 200 ;
    out x ;
}
out x ;

.
