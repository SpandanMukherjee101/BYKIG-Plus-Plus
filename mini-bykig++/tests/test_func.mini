func add ( a , b )
{
    return a + b ;
}

var sum = add ( 15 , 25 ) ;
out sum ;

func greet ( name )
{
    return "Hello, " + name + "!" ;
}

var g = greet ( "Alice" ) ;
out g ;

func sayHello ( )
{
    out "Procedure called successfully" ;
}

sayHello ( ) ;

func fact ( n )
{
    if n <= 1
    {
        return 1 ;
    }
    return n * fact ( n - 1 ) ;
}

var f5 = fact ( 5 ) ;
out f5 ;

var combined = add ( 5 , 5 ) * fact ( 3 ) + add ( 10 , 2 ) ;
out combined ;

.
