// memory.bykig
// Manages variables for mini-bykig

map env = { "null" = 0 } ;

func setVar ( string name , float val ) {
    out "setting var: " + name + " = " + val + "%n" ;
    env [ name ] = val ;
}

func getVar ( string name ) {
    out "getting var: " + name + "%n" ;
    float val = env [ name ] ;
    return val ;
}
.
