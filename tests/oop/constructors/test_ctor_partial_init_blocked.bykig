class ParentReq
{
    public float pVal ;

    public func construct ( float p )
    {
        this . pVal = p ;
    }
}

class ChildNoCtor extends ParentReq
{
    public float cVal ;
}

class GrandchildNoCtor extends ChildNoCtor
{
    public float gVal ;
}

class ChildOmitSuper extends ParentReq
{
    public float cVal ;

    public func construct ( float c )
    {
        this . cVal = c ;
    }
}

class PrivateBase
{
    private func construct ( float x )
    {
    }
}

class DerivedCallPrivate extends PrivateBase
{
    public func construct ( float x )
    {
        super . construct ( x ) ;
    }
}

ChildNoCtor c1 = new ChildNoCtor ( ) ;
out c1 ;

