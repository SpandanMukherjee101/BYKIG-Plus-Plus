class Person
{
    public string name ;
    public float age ;
    public float id ;

    public construct ( string n , float a , float i )
    {
        this . name = n ;
        this . age = a ;
        this . id = i ;
    }

    public func getInfo ( )
    {
        return this . name + " (" + this . age + ") ID=" + this . id ;
    }
}

Person p1 = new Person ( "Alice" , 30.0 , 1001.0 ) ;
out p1 . getInfo ( ) + "%n" ;

Person p2 = new Person ( "Bob" , 25.0 , 1002.0 ) ;
out p2 . getInfo ( ) + "%n" ;
.

