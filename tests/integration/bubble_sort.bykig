 
 

out "--- Integration Test: Bubble Sort ---%n" ;

list arr ;
push ( arr , 64 ) ;
push ( arr , 34 ) ;
push ( arr , 25 ) ;
push ( arr , 12 ) ;
push ( arr , 22 ) ;
push ( arr , 11 ) ;
push ( arr , 90 ) ;

int n = len ( arr ) ;
out "Original List Length: " + n + "%n" ;

int i = 0 ;
while i < n - 1
{
    int j = 0 ;
    while j < n - i - 1
    {
        float val1 ;
        val1 = arr [ j ] ;
        int idx2 = j + 1 ;
        float val2 ;
        val2 = arr [ idx2 ] ;
        
        if val1 > val2
        {
             
            arr [ j ] = val2 ;
            arr [ idx2 ] = val1 ;
        }
        j = j + 1 ;
    }
    i = i + 1 ;
}

out "Sorted List:%n" ;
int k = 0 ;
while k < n
{
    float elem ;
    elem = arr [ k ] ;
    out elem + " " ;
    k = k + 1 ;
}
out "%n" ;

 
float first ;
first = arr [ 0 ] ;
float last ;
last = arr [ 6 ] ;

if first ~ 11
{
    if last ~ 90
    {
        out "Bubble sort executed successfully!%n" ;
    }
}

out "--- Bubble Sort Complete ---%n" ;
.
