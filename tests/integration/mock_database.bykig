// Let's do a pure map test with dynamic keys
map accounts ;

string user1 = "Alice" ;
string user2 = "Bob" ;

accounts [ user1 ] = 1500.00 ;
accounts [ user2 ] = 2300.50 ;

func transfer ( string fromUser , string toUser , float amt ) {
    float b1 = accounts [ fromUser ] ;
    float b2 = accounts [ toUser ] ;
    
    if b1 >= amt
    {
        accounts [ fromUser ] = b1 - amt ;
        accounts [ toUser ] = b2 + amt ;
        out "Transfer successful!%n" ;
    }
    else
    {
        out "Insufficient funds!%n" ;
    }
}

out "Alice balance: " + accounts [ user1 ] + "%n" ;
out "Bob balance: " + accounts [ user2 ] + "%n" ;

out "Transferring 500 from Alice to Bob...%n" ;
transfer ( user1 , user2 , 500.0 ) ;

out "Alice balance: " + accounts [ user1 ] + "%n" ;
out "Bob balance: " + accounts [ user2 ] + "%n" ;

if accounts [ user1 ] == 1000.00
{
    if accounts [ user2 ] == 2800.50
    {
        out "Mock Database test passed!%n" ;
    }
}

out "--- Mock Database Complete ---%n" ;
